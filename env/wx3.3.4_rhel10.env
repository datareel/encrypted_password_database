# 10/27/2026: wxWidgets 3.3.4 for RHEL 8, 9 and 10, the default GUI build.
#
# The release build links the static gtk3 build made for EPDB:
#   ~/3plibs/wxWidgets-3.3.4_epdb_rhelN, N = 8, 9 or 10 (configure --disable-shared
#   --with-gtk=3 --disable-webview, CFLAGS/CXXFLAGS=-fPIC)
# The compile and link flags come from its wx-config. For a test build
# against another wxWidgets 3.3 build set WX_CONFIG, for example
#   make WX_CONFIG=$HOME/3plibs/wx-3.3.4-rhel10/bin/wx-config
# (a shared build needs LD_LIBRARY_PATH set to its lib64 to run).
WX_MAJOR_VERSION_NUMBER = 3
WX_MINOR_VERSION_NUMBER = 3
WX_RELEASE_NUMBER = 4
# The EPDB build is made with -fPIC, so the program is built as a PIE
WX_PIE ?= 1
WXSRCDIR ?= $(HOME)/3plibs/wxWidgets-3.3.4_epdb_rhel$(RHEL)
WX_CONFIG ?= $(WXSRCDIR)/bin/wx-config
WXINSTALLDIR = $(WXSRCDIR)
WX_LIBPATH =

WX_COMPILE_FLAGS = -Wundef -Wunused-parameter -Wno-ctor-dtor-privacy -Woverloaded-virtual -Wno-deprecated-declarations

WX_INCPATH = $(shell $(WX_CONFIG) --cxxflags)

WXLIBS = $(shell $(WX_CONFIG) --libs core,base,adv,html,xml)
