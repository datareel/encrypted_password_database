// Windows build resource file
//
// 10/27/2026: One icon for the program, the title bars and the
// installer (16 to 256 pixels, made by gui/tools/make_icons.py). The
// "appicon" name is loaded by EPDBAppIcons(). The wxWidgets manifest
// turns on the version 6 common controls and per-monitor (v2) DPI
// awareness, so the program is drawn at the monitor's own scale.

#define wxUSE_RC_MANIFEST 1
#define wxUSE_DPI_AWARE_MANIFEST 2

aaaaaaaa ICON "icons/encrypted_password_database.ico"
appicon ICON "icons/encrypted_password_database.ico"
encrypted_password_database ICON "icons/encrypted_password_database.ico"

#include "wx/msw/wx.rc"

#include <winver.h>
#include "epdb_version.h"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION EPDB_VERSION_MAJOR,EPDB_VERSION_MINOR,0,0
 PRODUCTVERSION EPDB_VERSION_MAJOR,EPDB_VERSION_MINOR,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "DataReel Open Source"
      VALUE "FileDescription", "Encrypted Password Database"
      VALUE "FileVersion", EPDB_VERSION_STRING
      VALUE "InternalName", "encrypted_password_database"
      VALUE "LegalCopyright", "Copyright (c) 2001-2026 DataReel Open Source, LGPL 3.0"
      VALUE "OriginalFilename", "encrypted_password_database.exe"
      VALUE "ProductName", "Encrypted Password Database"
      VALUE "ProductVersion", EPDB_VERSION_STRING
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
